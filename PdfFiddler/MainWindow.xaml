<Window
    x:Class="PdfFiddler.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PdfFiddler.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:PdfFiddler"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:PdfFiddler.ViewModels"
    Title="PDF Fiddler"
    Width="1000"
    Height="720"
    MinWidth="400"
    MinHeight="400"
    d:DataContext="{d:DesignInstance Type=viewmodels:PdfPageViewModel}"
    Background="#f5f5fa"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <SolidColorBrush x:Key="SelectedPageHighlight">#f76863</SolidColorBrush>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InvertBooleanConverter x:Key="InvertBool" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel
            Grid.Row="0"
            Margin="5"
            Orientation="Horizontal">
            <Button
                Margin="5"
                Padding="5,0"
                BorderBrush="DarkGray"
                Command="{Binding AddPagesFromPdfFileCommand}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    ToolTip="Add pages from PDF file">
                    <iconPacks:PackIconLucide
                        Width="16"
                        Height="16"
                        Margin="0,0,4,0"
                        Kind="FilePlusCorner" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Add PDF" />
                </StackPanel>
            </Button>
            <Button
                Margin="5"
                Padding="5,0"
                BorderBrush="DarkGray"
                Command="{Binding AddPagesFromImagesCommand}"
                ToolTip="Add pages from images">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    ToolTip="Add pages from image files">
                    <iconPacks:PackIconLucide
                        Width="16"
                        Height="16"
                        Margin="0,0,4,0"
                        Kind="ImagePlus" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Add Images" />
                </StackPanel>
            </Button>

            <Separator
                Width="25"
                Margin="10,0"
                BorderBrush="LightGray"
                BorderThickness="1">
                <Separator.LayoutTransform>
                    <RotateTransform Angle="90" />
                </Separator.LayoutTransform>
            </Separator>


            <Button
                Margin="5"
                Padding="5,0"
                BorderBrush="DarkGray"
                Command="{Binding RemoveSelectedPagesCommand}"
                ToolTip="Remove selected pages from document">
                <iconPacks:PackIconLucide
                    Width="16"
                    Height="16"
                    Kind="Trash2" />
            </Button>
            <Button
                Margin="5"
                Padding="5,0"
                BorderBrush="DarkGray"
                Command="{Binding RotateSelectedPagesCommand}"
                ToolTip="Rotate selected pages 90° clockwise">
                <iconPacks:PackIconLucide
                    Width="16"
                    Height="16"
                    Kind="RotateCw" />
            </Button>
            <Button
                Margin="5"
                Padding="5,0"
                BorderBrush="DarkGray"
                Command="{Binding MoveSelectedPagesUpCommand}"
                ToolTip="Move selected pages up">
                <iconPacks:PackIconLucide
                    Width="16"
                    Height="16"
                    Kind="ChevronsUp" />
            </Button>
            <Button
                Margin="5"
                Padding="5,0"
                BorderBrush="DarkGray"
                Command="{Binding MoveSelectedPagesDownCommand}"
                ToolTip="Move selected pages down">
                <iconPacks:PackIconLucide
                    Width="16"
                    Height="16"
                    Kind="ChevronsDown" />
            </Button>
            <Button
                Margin="5"
                Padding="5,0"
                BorderBrush="DarkGray"
                Command="{Binding ClearSelectionCommand}"
                ToolTip="Unselect all pages">
                <iconPacks:PackIconLucide
                    Width="16"
                    Height="16"
                    Kind="FileX" />
            </Button>

            <Separator
                Width="25"
                Margin="10,0"
                BorderBrush="LightGray"
                BorderThickness="1">
                <Separator.LayoutTransform>
                    <RotateTransform Angle="90" />
                </Separator.LayoutTransform>
            </Separator>

            <Button
                x:Name="zoomOutButton"
                Margin="5"
                Padding="5"
                Click="zoomOutButton_Click"
                ToolTip="Zoom out">
                <iconPacks:PackIconLucide
                    Width="16"
                    Height="16"
                    Kind="ZoomOut" />
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="BorderBrush" Value="DarkGray" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                    <Condition Binding="{Binding IsEmpty}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button
                x:Name="zoomInButton"
                Margin="5"
                Padding="5"
                Click="zoomInButton_Click"
                ToolTip="Zoom in">
                <iconPacks:PackIconLucide
                    Width="16"
                    Height="16"
                    Kind="ZoomIn" />
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="BorderBrush" Value="DarkGray" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                    <Condition Binding="{Binding IsEmpty}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Separator
                Width="25"
                Margin="10,0"
                BorderBrush="LightGray"
                BorderThickness="1">
                <Separator.LayoutTransform>
                    <RotateTransform Angle="90" />
                </Separator.LayoutTransform>
            </Separator>

            <Button
                Margin="5"
                Padding="5,0"
                BorderBrush="DarkGray"
                Command="{Binding ResetCommand}"
                ToolTip="Start new document">
                <iconPacks:PackIconLucide
                    Width="16"
                    Height="16"
                    Kind="BrushCleaning" />
            </Button>
            <Button
                Margin="5"
                Padding="5,0"
                BorderBrush="DarkGray"
                Command="{Binding SaveDocumentAsCommand}"
                ToolTip="Save the current document">
                <iconPacks:PackIconLucide
                    Width="16"
                    Height="16"
                    Kind="Save" />
            </Button>
        </StackPanel>

        <!--  Document View  -->
        <ListBox
            x:Name="pagesPreviewListBox"
            Grid.Row="1"
            Padding="10"
            HorizontalContentAlignment="Stretch"
            Background="#f5f5fa"
            ItemsSource="{Binding Pages}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionMode="Extended">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center" IsItemsHost="True" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="5"
                        Background="Transparent"
                        CornerRadius="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource SelectedPageHighlight}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Margin" Value="4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False">
                                        <Setter Property="BorderBrush" Value="LightGray" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Margin" Value="5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center">
                            <Image
                                x:Name="previewImage"
                                Width="200"
                                Height="200"
                                Source="{Binding Thumbnail}"
                                Stretch="Uniform" />
                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="{Binding PageNumber, StringFormat=Page {0}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SelectedPageHighlight}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False">
                                                <Setter Property="Foreground" Value="Gray" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  Progress Overlay  -->
        <Border Grid.Row="1" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="LightGray" />
            </Border.Background>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    Grid.Column="0"
                    Width="500"
                    Height="40"
                    Margin="15,0"
                    BorderBrush="LightGray"
                    BorderThickness="2"
                    Foreground="#43b078"
                    Maximum="100"
                    Value="{Binding ProgressPercentage}" />

                <TextBlock
                    Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="DemiBold"
                    Text="{Binding ProgressPercentage, StringFormat={}{0,0}%}" />

            </Grid>
        </Border>

        <!--  Footer  -->
        <Border Grid.Row="2" Padding="6,4,0,5">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontWeight="DemiBold"
                Foreground="DimGray"
                Text="By Omar Rwemi" />
        </Border>
    </Grid>
</Window>
