<Window
    x:Class="PdfFiddler.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PdfFiddler"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:PdfFiddler.ViewModels"
    xmlns:views="clr-namespace:PdfFiddler.Views"
    Title="MainWindow"
    Width="1000"
    Height="720"
    d:DataContext="{d:DesignInstance Type=viewmodels:PdfPageViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button
                Width="100"
                Height="30"
                Margin="5"
                Command="{Binding AddPagesFromPdfFileCommand}">
                Add PDF File
            </Button>
            <Button
                Width="100"
                Height="30"
                Margin="5">
                Add Image
            </Button>
            <Button
                Width="100"
                Height="30"
                Margin="5"
                Command="{Binding ResetCommand}">
                Reset
            </Button>

            <TextBlock
                Padding="5,0"
                VerticalAlignment="Center"
                FontSize="20"
                Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}"
                TextAlignment="Center" />

            <ProgressBar
                Width="200"
                Height="30"
                Maximum="100"
                Value="{Binding ProgressPercentage}" />
        </StackPanel>

        <Border Grid.Row="1">
            <ListBox ItemsSource="{Binding Pages}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1">
                            <StackPanel>

                                <Image
                                    Width="170"
                                    Source="{Binding Thumbnail}"
                                    Stretch="Uniform" />
                                <TextBlock Text="{Binding PageNumber}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="2" Padding="5,0">
            <TextBlock>By Omar Rwemi</TextBlock>
        </Border>
    </Grid>
</Window>
