<Window
    x:Class="PdfFiddler.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PdfFiddler"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:PdfFiddler.ViewModels"
    xmlns:views="clr-namespace:PdfFiddler.Views"
    Title="PDF Fiddler"
    Width="1000"
    Height="720"
    d:DataContext="{d:DesignInstance Type=viewmodels:PdfPageViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button
                Width="100"
                Height="30"
                Margin="5"
                Command="{Binding AddPagesFromPdfFileCommand}">
                Add PDF File
            </Button>
            <Button
                Width="100"
                Height="30"
                Margin="5"
                Command="{Binding AddPagesFromImagesCommand}">
                Add Images
            </Button>
            <Button
                Width="100"
                Height="30"
                Margin="5"
                Command="{Binding ResetCommand}">
                Reset
            </Button>
            <Button
                Width="100"
                Height="30"
                Margin="5"
                Command="{Binding SaveDocumentAsCommand}">
                SaveAs
            </Button>
            <Button
                x:Name="zoomOutButton"
                Width="40"
                Height="30"
                Margin="5"
                Click="zoomOutButton_Click">
                -
            </Button>
            <Button
                x:Name="zoomInButton"
                Width="40"
                Height="30"
                Margin="1"
                Click="zoomInButton_Click">
                +
            </Button>
        </StackPanel>



        <Border Grid.Row="1">
            <ListBox
                x:Name="pagesPreviewListBox"
                Padding="10"
                Background="#f5f5fa"
                ItemsSource="{Binding Pages}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="5"
                            Padding="8"
                            BorderBrush="LightGray"
                            BorderThickness="0"
                            CornerRadius="5">
                            <StackPanel VerticalAlignment="Center">
                                <Image
                                    x:Name="previewImage"
                                    Width="200"
                                    Height="200"
                                    Source="{Binding Thumbnail}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="Gray"
                                    Text="{Binding PageNumber, StringFormat=Page {0}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="2" Padding="5,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="By Omar Rwemi" />

                <ProgressBar
                    Grid.Column="2"
                    Width="250"
                    Height="20"
                    Maximum="100"
                    Value="{Binding ProgressPercentage}" />

                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}" />

            </Grid>
        </Border>
    </Grid>
</Window>
